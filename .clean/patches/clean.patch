+++ b/tests/components/OwnedProviderForms.test.tsx
@@ -0,0 +1,257 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { QueryClientProvider } from "@tanstack/react-query";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { http, HttpResponse } from "msw";
+import { ProviderForm } from "@/components/providers/forms/ProviderForm";
+import { ClaudeDesktopProviderForm } from "@/components/providers/forms/ClaudeDesktopProviderForm";
+import { McodeProviderForm } from "@/components/providers/forms/McodeProviderForm";
+import type { AppId } from "@/lib/api";
+import { createTestQueryClient } from "../utils/testQueryClient";
+import { server } from "../msw/server";
+
+vi.mock("@/components/JsonEditor", () => ({
+  default: ({ value }: { value: string }) => (
+    <textarea readOnly value={value} />
+  ),
+}));
+
+vi.mock("@/components/providers/forms/hooks", async (importOriginal) => {
+  const actual =
+    await importOriginal<typeof import("@/components/providers/forms/hooks")>();
+  const signedOut = () => ({
+    isAuthenticated: false,
+    isStatusSuccess: true,
+    isStatusError: false,
+    defaultAccountId: null,
+    accounts: [],
+  });
+  return {
+    ...actual,
+    useCopilotAuth: signedOut,
+    useCodexOauth: signedOut,
+    useXaiOauth: signedOut,
+  };
+});
+
+const cases: Array<{
+  app: AppId;
+  service: string;
+  baseUrl: string;
+  protocol: string;
+  hint: string;
+  providerKey?: string;
+}> = [
+  {
+    app: "claude",
+    service: "CodexZH",
+    baseUrl: "https://api.codexzh.com",
+    protocol: "anthropic",
+    hint: "codexzhClaude",
+  },
+  {
+    app: "claude",
+    service: "CcodeZH",
+    baseUrl: "https://api.ccodezh.com",
+    protocol: "anthropic",
+    hint: "ccodezhClaude",
+  },
+  {
+    app: "codex",
+    service: "CodexZH",
+    baseUrl: "https://api.codexzh.com/v1",
+    protocol: "responses",
+    hint: "codexzhResponses",
+  },
+  {
+    app: "codex",
+    service: "CcodeZH",
+    baseUrl: "https://api.ccodezh.com/v1",
+    protocol: "responses",
+    hint: "ccodezhCodex",
+  },
+  {
+    app: "opencode",
+    service: "CodexZH",
+    baseUrl: "https://api.codexzh.com/v1",
+    protocol: "@ai-sdk/openai",
+    hint: "codexzhResponses",
+    providerKey: "openai",
+  },
+  {
+    app: "opencode",
+    service: "CcodeZH",
+    baseUrl: "https://api.ccodezh.com/v1",
+    protocol: "@ai-sdk/anthropic",
+    hint: "ccodezhThirdParty",
+    providerKey: "ccodezh",
+  },
+  {
+    app: "openclaw",
+    service: "CodexZH",
+    baseUrl: "https://api.codexzh.com/v1",
+    protocol: "openai-responses",
+    hint: "codexzhResponses",
+    providerKey: "codexzh",
+  },
+  {
+    app: "openclaw",
+    service: "CcodeZH",
+    baseUrl: "https://api.ccodezh.com",
+    protocol: "anthropic-messages",
+    hint: "ccodezhThirdParty",
+    providerKey: "ccodezh",
+  },
+  {
+    app: "hermes",
+    service: "CodexZH",
+    baseUrl: "https://api.codexzh.com/v1",
+    protocol: "codex_responses",
+    hint: "codexzhResponses",
+    providerKey: "codexzh",
+  },
+];
+
+describe("owned provider templates use the existing forms", () => {
+  beforeEach(() => {
+    server.use(
+      http.post("http://tauri.local/get_hermes_live_provider_ids", () =>
+        HttpResponse.json([]),
+      ),
+      http.post("http://tauri.local/get_claude_desktop_default_routes", () =>
+        HttpResponse.json([]),
+      ),
+    );
+  });
+  it.each(cases)(
+    "$app / $service waits for the user's key and saves the documented protocol",
+    async ({ app, service, baseUrl, protocol, hint, providerKey }) => {
+      const submit = vi.fn();
+      const { container } = render(
+        <QueryClientProvider client={createTestQueryClient()}>
+          <ProviderForm
+            appId={app}
+            submitLabel="save-owned"
+            onSubmit={submit}
+            onCancel={vi.fn()}
+          />
+        </QueryClientProvider>,
+      );
+      fireEvent.click(screen.getByRole("button", { name: service }));
+      await waitFor(() =>
+        expect(screen.getByLabelText("API Key")).toHaveValue(""),
+      );
+      expect(screen.getByDisplayValue(baseUrl)).toBeInTheDocument();
+      expect(
+        container.querySelector("[data-owned-provider-hint]"),
+      ).toHaveTextContent(`providerPreset.owned.${hint}`);
+      expect(submit).not.toHaveBeenCalled();
+
+      fireEvent.change(screen.getByLabelText("API Key"), {
+        target: { value: "sk-user-supplied-test-key" },
+      });
+      fireEvent.click(screen.getByRole("button", { name: "save-owned" }));
+      await waitFor(() => expect(submit).toHaveBeenCalledTimes(1));
+      const saved = submit.mock.calls[0][0];
+      const config = JSON.parse(saved.settingsConfig);
+      expect(saved.name).toBe(service);
+      expect(saved.websiteUrl).toBe(
+        service === "CodexZH" ? "https://codexzh.com" : "https://ccodezh.com",
+      );
+      if (providerKey) expect(saved.providerKey).toBe(providerKey);
+      if (app === "claude") {
+        expect(config.env.ANTHROPIC_BASE_URL).toBe(baseUrl);
+        expect(config.env.ANTHROPIC_AUTH_TOKEN).toBe(
+          "sk-user-supplied-test-key",
+        );
+        expect(saved.meta.apiFormat).toBe(protocol);
+        if (service === "CodexZH") {
+          expect(config.env.ANTHROPIC_MODEL).toBe("cc-grok-4.6");
+          expect(config.env.ANTHROPIC_DEFAULT_HAIKU_MODEL).toBe("cc-grok-4.6");
+        }
+      } else if (app === "codex") {
+        expect(config.config).toContain(`base_url = "${baseUrl}"`);
+        expect(config.config).toContain(`wire_api = "${protocol}"`);
+        expect(config.auth.OPENAI_API_KEY).toBe("sk-user-supplied-test-key");
+      } else if (app === "opencode") {
+        expect(config.npm).toBe(protocol);
+        expect(config.options.baseURL).toBe(baseUrl);
+        expect(config.options.apiKey).toBe("sk-user-supplied-test-key");
+        if (service === "CodexZH")
+          expect(config.options.setCacheKey).toBe(true);
+      } else if (app === "openclaw") {
+        expect(config.api).toBe(protocol);
+        expect(config.baseUrl).toBe(baseUrl);
+        expect(config.apiKey).toBe("sk-user-supplied-test-key");
+      } else {
+        expect(config.api_mode).toBe(protocol);
+        expect(config.base_url).toBe(baseUrl);
+        expect(config.api_key).toBe("sk-user-supplied-test-key");
+      }
+    },
+  );
+
+  it.each(["CodexZH", "CcodeZH"])(
+    "Claude Desktop / %s remains a manual save with a blank key",
+    async (service) => {
+      const submit = vi.fn();
+      render(
+        <QueryClientProvider client={createTestQueryClient()}>
+          <ClaudeDesktopProviderForm
+            submitLabel="save-owned"
+            onSubmit={submit}
+            onCancel={vi.fn()}
+          />
+        </QueryClientProvider>,
+      );
+      fireEvent.click(screen.getByRole("button", { name: service }));
+      expect(screen.getByLabelText("API Key")).toHaveValue("");
+      const baseUrl =
+        service === "CodexZH"
+          ? "https://api.codexzh.com"
+          : "https://api.ccodezh.com";
+      expect(screen.getByDisplayValue(baseUrl)).toBeInTheDocument();
+      expect(submit).not.toHaveBeenCalled();
+      fireEvent.change(screen.getByLabelText("API Key"), {
+        target: { value: "sk-user-supplied-test-key" },
+      });
+      fireEvent.click(screen.getByRole("button", { name: "save-owned" }));
+      await waitFor(() => expect(submit).toHaveBeenCalledTimes(1));
+      const saved = submit.mock.calls[0][0];
+      expect(JSON.stringify(saved)).toContain(baseUrl);
+      expect(JSON.stringify(saved)).toContain("sk-user-supplied-test-key");
+      if (service === "CodexZH")
+        expect(JSON.stringify(saved)).toContain("cc-grok-4.6");
+    },
+  );
+
+  it("DSH / CodexZH retains Responses and does not add a card before save", async () => {
+    const submit = vi.fn();
+    render(
+      <QueryClientProvider client={createTestQueryClient()}>
+        <McodeProviderForm
+          appId="dsh"
+          submitLabel="save-owned"
+          onSubmit={submit}
+          onCancel={vi.fn()}
+        />
+      </QueryClientProvider>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "CodexZH" }));
+    expect(screen.getByLabelText("API Key")).toHaveValue("");
+    expect(submit).not.toHaveBeenCalled();
+    fireEvent.change(screen.getByLabelText("API Key"), {
+      target: { value: "sk-user-supplied-test-key" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: "save-owned" }));
+    await waitFor(() => expect(submit).toHaveBeenCalledTimes(1));
+    const saved = submit.mock.calls[0][0];
+    expect(saved.providerKey).toBe("codexzh");
+    expect(JSON.parse(saved.settingsConfig)).toMatchObject({
+      api: "openai-responses",
+      options: {
+        baseURL: "https://api.codexzh.com/v1",
+        apiKey: "sk-user-supplied-test-key",
+      },
+    });
+  });
+});
