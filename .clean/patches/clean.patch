+++ b/tests/components/CleanProviders.test.tsx
@@ -0,0 +1,276 @@
+import { render, renderHook, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import i18n from "i18next";
+import { providerPresets } from "@/config/claudeProviderPresets";
+import { claudeDesktopProviderPresets } from "@/config/claudeDesktopProviderPresets";
+import { codexProviderPresets } from "@/config/codexProviderPresets";
+import { geminiProviderPresets } from "@/config/geminiProviderPresets";
+import { grokBuildProviderPresets } from "@/config/grokBuildProviderPresets";
+import { opencodeProviderPresets } from "@/config/opencodeProviderPresets";
+import { openclawProviderPresets } from "@/config/openclawProviderPresets";
+import { hermesProviderPresets } from "@/config/hermesProviderPresets";
+import { piProviderPresets } from "@/config/piProviderPresets";
+import { ompProviderPresets } from "@/config/ompProviderPresets";
+import { mcodeProviderPresets } from "@/config/mcodeProviderPresets";
+import { dshProviderPresets } from "@/config/dshProviderPresets";
+import { kimiProviderPresets } from "@/config/kimiProviderPresets";
+import { copilotProviderPresets } from "@/config/copilotProviderPresets";
+import { workbuddyProviderPresets } from "@/config/workbuddyProviderPresets";
+import { codebuddyProviderPresets } from "@/config/codebuddyProviderPresets";
+import { universalProviderPresets } from "@/config/universalProviderPresets";
+import {
+  ProviderPresetSelector,
+  type AnyPreset,
+} from "@/components/providers/forms/ProviderPresetSelector";
+import { ApiKeySection } from "@/components/providers/forms/shared/ApiKeySection";
+import { useApiKeyLink } from "@/components/providers/forms/hooks/useApiKeyLink";
+
+const catalogs: Array<[string, AnyPreset[]]> = [
+  ["claude", providerPresets],
+  ["claude-desktop", claudeDesktopProviderPresets],
+  ["codex", codexProviderPresets],
+  ["gemini", geminiProviderPresets],
+  ["agy", geminiProviderPresets],
+  ["grokbuild", grokBuildProviderPresets],
+  ["opencode", opencodeProviderPresets],
+  ["openclaw", openclawProviderPresets],
+  ["hermes", hermesProviderPresets],
+  ["pi", piProviderPresets],
+  ["omp", ompProviderPresets],
+  ["mcode", mcodeProviderPresets],
+  ["dsh", dshProviderPresets],
+  ["kimi", kimiProviderPresets],
+  ["copilot", copilotProviderPresets],
+  ["workbuddy", workbuddyProviderPresets],
+  ["codebuddy", codebuddyProviderPresets],
+];
+
+const expectedServices: Record<string, string[]> = {
+  claude: ["CodexZH", "CcodeZH"],
+  "claude-desktop": ["CodexZH", "CcodeZH"],
+  codex: ["CodexZH", "CcodeZH"],
+  opencode: ["CodexZH", "CcodeZH"],
+  openclaw: ["CodexZH", "CcodeZH"],
+  hermes: ["CodexZH"],
+  dsh: ["CodexZH"],
+};
+
+describe("clean provider picker", () => {
+  it.each(catalogs)(
+    "%s offers custom configuration and only its verified owned services",
+    async (app, presets) => {
+      const choose = vi.fn();
+      const user = userEvent.setup();
+      render(
+        <ProviderPresetSelector
+          selectedPresetId="custom"
+          presetEntries={presets.map((preset, index) => ({
+            id: String(index),
+            preset,
+          }))}
+          onPresetChange={choose}
+        />,
+      );
+
+      // The exact allowlist also rejects accidental propagation into clients
+      // without a documented protocol, and newly added upstream suppliers.
+      const expected = [
+        "providerPreset.custom",
+        ...(expectedServices[app] ?? []),
+      ];
+      expect(
+        screen
+          .getAllByRole("button")
+          .map((button) => button.getAttribute("aria-label")),
+      ).toEqual(expected);
+      expect(screen.queryByRole("link")).not.toBeInTheDocument();
+      for (const service of expectedServices[app] ?? []) {
+        await user.click(screen.getByRole("button", { name: service }));
+        expect(choose).toHaveBeenLastCalledWith(
+          String(presets.findIndex((preset) => preset.name === service)),
+        );
+      }
+      await user.click(
+        screen.getByRole("button", { name: "providerPreset.custom" }),
+      );
+      expect(choose).toHaveBeenCalledWith("custom");
+    },
+  );
+
+  it("keeps the CodeBuddy official account login as the only connection method", () => {
+    const presets = codebuddyProviderPresets;
+    render(
+      <ProviderPresetSelector
+        selectedPresetId="custom"
+        presetEntries={presets.map((preset, index) => ({
+          id: String(index),
+          preset,
+        }))}
+        onPresetChange={vi.fn()}
+      />,
+    );
+    const official = presets.findIndex(
+      (preset) => preset.category === "official",
+    );
+    expect(official).toBeGreaterThanOrEqual(0);
+    expect(
+      screen
+        .getAllByRole("option")
+        .map((option) => option.getAttribute("value")),
+    ).toEqual(["custom", String(official)]);
+  });
+
+  it("keeps cross-client OAuth choices wired to their original IDs", async () => {
+    const choose = vi.fn();
+    const user = userEvent.setup();
+    const index = providerPresets.findIndex(
+      (preset) => preset.providerType === "codex_oauth",
+    );
+    expect(index).toBeGreaterThanOrEqual(0);
+    render(
+      <ProviderPresetSelector
+        selectedPresetId="custom"
+        presetEntries={providerPresets.map((preset, i) => ({
+          id: `claude-${i}`,
+          preset,
+        }))}
+        onPresetChange={choose}
+      />,
+    );
+    await user.selectOptions(screen.getByRole("combobox"), `claude-${index}`);
+    expect(choose).toHaveBeenCalledWith(`claude-${index}`);
+  });
+
+  it("does not admit newly added ordinary vendors into connection choices", () => {
+    render(
+      <ProviderPresetSelector
+        selectedPresetId="custom"
+        presetEntries={[
+          {
+            id: "new-vendor",
+            preset: {
+              name: "New Official Vendor",
+              category: "official",
+              websiteUrl: "https://vendor.example",
+              settingsConfig: {},
+            },
+          },
+          {
+            id: "new-cloud",
+            preset: {
+              name: "New Cloud Vendor",
+              category: "cloud_provider",
+              websiteUrl: "https://cloud.example",
+              settingsConfig: {},
+            },
+          },
+          {
+            id: "copied-service-name",
+            preset: {
+              name: "CodexZH",
+              category: "third_party",
+              websiteUrl: "https://codexzh.com",
+              settingsConfig: {},
+            },
+          },
+        ]}
+        onPresetChange={vi.fn()}
+      />,
+    );
+    expect(screen.queryByRole("combobox")).not.toBeInTheDocument();
+    expect(screen.queryByText(/New .* Vendor/)).not.toBeInTheDocument();
+    expect(screen.queryByText("CodexZH")).not.toBeInTheDocument();
+  });
+
+  it("keeps the custom universal gateway without a named vendor template", async () => {
+    const openUniversal = vi.fn();
+    const user = userEvent.setup();
+    render(
+      <ProviderPresetSelector
+        selectedPresetId="custom"
+        presetEntries={[]}
+        onPresetChange={vi.fn()}
+        onUniversalPresetSelect={openUniversal}
+      />,
+    );
+    expect(screen.queryByText("NewAPI")).not.toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "自定义网关" }));
+    expect(openUniversal).toHaveBeenCalledWith(
+      expect.objectContaining({ isCustomTemplate: true }),
+    );
+    expect(universalProviderPresets).toHaveLength(1);
+  });
+});
+
+describe("clean provider links and help", () => {
+  it("does not inject an affiliate URL for an imported endpoint", () => {
+    const { result } = renderHook(() =>
+      useApiKeyLink({
+        appId: "claude",
+        category: "third_party",
+        selectedPresetId: "custom",
+        formBaseUrl: "https://vendor.example/v1",
+        formWebsiteUrl: "https://my-saved-url.example",
+        presetEntries: [
+          {
+            id: "vendor",
+            preset: {
+              name: "Advertised vendor",
+              category: "third_party",
+              websiteUrl: "https://vendor.example",
+              apiKeyUrl: "https://vendor.example/register?ref=advertiser",
+              partnerPromotionKey: "advertiser",
+              settingsConfig: {
+                env: { ANTHROPIC_BASE_URL: "https://vendor.example/v1" },
+              },
+            },
+          },
+        ],
+      }),
+    );
+    expect(result.current.websiteUrl).toBe("https://my-saved-url.example");
+  });
+
+  it("retains the Google OAuth marker needed by the official authentication form", () => {
+    const { result } = renderHook(() =>
+      useApiKeyLink({
+        appId: "gemini",
+        category: "official",
+        selectedPresetId: "google-account",
+        formWebsiteUrl: "",
+        presetEntries: [
+          { id: "google-account", preset: geminiProviderPresets[0] },
+        ],
+      }),
+    );
+    expect(result.current.partnerPromotionKey).toBe("google-official");
+  });
+
+  it("shows functional API-key help without promotion copy", () => {
+    i18n.addResource(
+      "zh",
+      "translation",
+      "providerForm.partnerPromotion.kimi",
+      "This is sponsor text",
+    );
+    render(
+      <ApiKeySection
+        value=""
+        onChange={vi.fn()}
+        shouldShowLink={true}
+        websiteUrl="https://user-entered.example/keys"
+        partnerPromotionKey="kimi"
+        hint="Keep this functional input hint"
+      />,
+    );
+    expect(
+      screen.getByText("Keep this functional input hint"),
+    ).toBeInTheDocument();
+    expect(screen.queryByText("This is sponsor text")).not.toBeInTheDocument();
+    expect(screen.getByRole("link")).toHaveAttribute(
+      "href",
+      "https://user-entered.example/keys",
+    );
+  });
+});
diff --git a/tests/components/OwnedProviderForms.test.tsx b/tests/components/OwnedProviderForms.test.tsx
