+          baseURL: "https://api.codexzh.com/v1",
+          apiKey: "",
+          setCacheKey: true,
+        },
+        models: { "gpt-6.1-sol": { name: "GPT-6.1 Sol" } },
+      },
+    },
+    { ...codexzhResponses, providerKey: "openai" },
+  ),
+  register<OpenCodeProviderPreset>(
+    {
+      ...ccodezh,
+      settingsConfig: {
+        npm: "@ai-sdk/anthropic",
+        name: "CcodeZH",
+        options: { baseURL: "https://api.ccodezh.com/v1", apiKey: "" },
+        models: {
+          "claude-sonnet-5-5": { name: "Claude Sonnet 5.5" },
+          "claude-opus-5-5": { name: "Claude Opus 5.5" },
+          "claude-haiku-4-5-20251001": { name: "Claude Haiku 4.5" },
+        },
+      },
+    },
+    ccodezhThirdParty,
+  ),
+];
+
+export const ownedOpenclawPresets: OpenClawProviderPreset[] = [
+  register<OpenClawProviderPreset>(
+    {
+      ...codexzh,
+      settingsConfig: {
+        baseUrl: "https://api.codexzh.com/v1",
+        apiKey: "",
+        api: "openai-responses",
+        models: [{ id: "gpt-6.1-sol", name: "GPT-6.1 Sol" }],
+      },
+      suggestedDefaults: { model: { primary: "codexzh/gpt-6.1-sol" } },
+    },
+    codexzhResponses,
+  ),
+  register<OpenClawProviderPreset>(
+    {
+      ...ccodezh,
+      settingsConfig: {
+        baseUrl: "https://api.ccodezh.com",
+        apiKey: "",
+        api: "anthropic-messages",
+        models: [{ id: "claude-sonnet-5-5", name: "Claude Sonnet 5.5" }],
+      },
+      suggestedDefaults: {
+        model: { primary: "ccodezh/claude-sonnet-5-5" },
+      },
+    },
+    ccodezhThirdParty,
+  ),
+];
+
+export const ownedHermesPresets: HermesProviderPreset[] = [
+  register<HermesProviderPreset>(
+    {
+      ...codexzh,
+      providerKey: "codexzh",
+      settingsConfig: {
+        name: "codexzh",
+        base_url: "https://api.codexzh.com/v1",
+        api_key: "",
