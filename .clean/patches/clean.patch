+      },
+      suggestedDefaults: { model: { default: "gpt-5.6-sol" } },
+    },
+    codexzhResponses,
+  ),
+];
+
+export const ownedDshPresets: McodeProviderPreset[] = [
+  register<McodeProviderPreset>(
+    {
+      ...codexzh,
+      providerKey: "codexzh",
+      settingsConfig: {
+        name: "CodexZH",
+        kind: "custom",
+        enabled: true,
+        api: "openai-responses",
+        options: { baseURL: "https://api.codexzh.com/v1", apiKey: "" },
+        models: {
+          "gpt-6.1-sol": {
+            name: "GPT-6.1 Sol",
+            modalities: { input: ["text", "image"], output: ["text"] },
+            reasoning: true,
+            reasoningEfforts: { low: "low", medium: "medium", high: "high" },
