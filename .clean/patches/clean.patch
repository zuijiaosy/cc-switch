--- /dev/null
+++ b/src/config/ownedProviderPresets.ts
@@ -0,0 +1,285 @@
+import type { ProviderPreset } from "./claudeProviderPresets";
+import type { ClaudeDesktopProviderPreset } from "./claudeDesktopProviderPresets";
+import type { CodexProviderPreset } from "./codexProviderPresets";
+import type { OpenCodeProviderPreset } from "./opencodeProviderPresets";
+import type { OpenClawProviderPreset } from "./openclawProviderPresets";
+import type { HermesProviderPreset } from "./hermesProviderPresets";
+import type { McodeProviderPreset } from "./mcodeProviderPresets";
+
+/**
+ * This distribution's two explicitly requested services. These templates only
+ * fill the add-provider form; they never create providers or contain API keys.
+ * Keep the verified protocol/client combinations explicit. In particular,
+ * neither service has a documented native Gemini configuration.
+ *
+ * Sources checked 2026-11-19:
+ * https://codexzh.com/
+ * https://docs.codexzh.com/claude-code/codexzh-models
+ * https://docs.codexzh.com/claude-code/clients
+ * https://docs.codexzh.com/claude-code/cx-codex
+ * https://docs.codexzh.com/claude-code/opencode
+ * https://docs.codexzh.com/claude-code/openclaw
+ * https://docs.codexzh.com/codex/opencode
+ * https://docs.codexzh.com/codex/openclaw
+ * https://docs.codexzh.com/codex/hermes-config
+ * https://docs.codexzh.com/codex/deepseek-harness
+ */
+export interface OwnedProviderDetails {
+  id: "codexzh" | "ccodezh";
+  hintKey: string;
+  providerKey?: string;
+}
+
+const registeredPresets = new WeakMap<object, OwnedProviderDetails>();
+
+function register<T extends object>(
+  preset: T,
+  details: OwnedProviderDetails,
+): T {
+  registeredPresets.set(preset, details);
+  return preset;
+}
+
+// Match exact registered templates, not names or domains which a future
+// upstream preset could reuse. Unknown upstream suppliers remain hidden.
+export function ownedProviderDetails(
+  preset: object,
+): OwnedProviderDetails | undefined {
+  return registeredPresets.get(preset);
+}
+
+const codexzh = {
+  name: "CodexZH",
+  websiteUrl: "https://codexzh.com",
+  category: "third_party" as const,
+};
+
+const ccodezh = {
+  name: "CcodeZH",
+  websiteUrl: "https://ccodezh.com",
+  category: "third_party" as const,
+};
+
+const codexzhResponses = {
+  id: "codexzh" as const,
+  hintKey: "providerPreset.owned.codexzhResponses",
+  providerKey: "codexzh",
+};
+const codexzhClaude = {
+  id: "codexzh" as const,
+  hintKey: "providerPreset.owned.codexzhClaude",
+};
+const ccodezhThirdParty = {
+  id: "ccodezh" as const,
+  hintKey: "providerPreset.owned.ccodezhThirdParty",
+  providerKey: "ccodezh",
+};
+
+export const ownedClaudePresets: ProviderPreset[] = [
+  register<ProviderPreset>(
+    {
+      ...codexzh,
+      apiFormat: "anthropic",
+      apiKeyField: "ANTHROPIC_AUTH_TOKEN",
+      settingsConfig: {
+        env: {
+          ANTHROPIC_BASE_URL: "https://api.codexzh.com",
+          ANTHROPIC_AUTH_TOKEN: "",
+          ANTHROPIC_MODEL: "cc-grok-4.6",
+          ANTHROPIC_DEFAULT_OPUS_MODEL: "cc-grok-4.6",
+          ANTHROPIC_DEFAULT_SONNET_MODEL: "cc-grok-4.6",
+          ANTHROPIC_DEFAULT_HAIKU_MODEL: "cc-grok-4.6",
+        },
+      },
+    },
+    codexzhClaude,
+  ),
+  register<ProviderPreset>(
+    {
+      ...ccodezh,
+      apiFormat: "anthropic",
+      apiKeyField: "ANTHROPIC_AUTH_TOKEN",
+      settingsConfig: {
+        env: {
+          ANTHROPIC_BASE_URL: "https://api.ccodezh.com",
+          ANTHROPIC_AUTH_TOKEN: "",
+        },
+      },
+    },
+    { id: "ccodezh", hintKey: "providerPreset.owned.ccodezhClaude" },
+  ),
+];
+
+export const ownedClaudeDesktopPresets: ClaudeDesktopProviderPreset[] = [
+  register<ClaudeDesktopProviderPreset>(
+    {
+      ...codexzh,
+      baseUrl: "https://api.codexzh.com",
+      apiKeyField: "ANTHROPIC_AUTH_TOKEN",
+      apiFormat: "anthropic",
+      // Desktop validates Claude-shaped route IDs. Keep the upstream mapping
+      // mode and send the documented cc-* model through that existing route.
+      mode: "proxy",
+      modelRoutes: [
+        {
+          routeId: "claude-sonnet-5",
+          upstreamModel: "cc-grok-4.6",
+          labelOverride: "Grok 4.6",
+          supports1m: false,
+        },
+      ],
+    },
+    codexzhClaude,
+  ),
+  register<ClaudeDesktopProviderPreset>(
+    {
+      ...ccodezh,
+      baseUrl: "https://api.ccodezh.com",
+      apiKeyField: "ANTHROPIC_AUTH_TOKEN",
+      apiFormat: "anthropic",
+      mode: "direct",
+    },
+    { id: "ccodezh", hintKey: "providerPreset.owned.ccodezhDesktop" },
+  ),
+];
+
+const responsesConfig = (id: string, name: string, model: string) =>
+  `model_provider = "${id}"
+model = "${model}"
+model_reasoning_effort = "high"
+
+[model_providers.${id}]
+name = "${name}"
+base_url = "https://api.${id}.com/v1"
+wire_api = "responses"
+requires_openai_auth = true`;
+
+export const ownedCodexPresets: CodexProviderPreset[] = [
+  register<CodexProviderPreset>(
+    {
+      ...codexzh,
+      auth: { OPENAI_API_KEY: "" },
+      config: responsesConfig("codexzh", "CodexZH", "gpt-6.1-sol"),
+      apiFormat: "openai_responses",
+    },
+    codexzhResponses,
+  ),
+  register<CodexProviderPreset>(
+    {
+      ...ccodezh,
+      auth: { OPENAI_API_KEY: "" },
+      config: responsesConfig("ccodezh", "CcodeZH", "gpt-5.6-sol"),
+      apiFormat: "openai_responses",
+    },
+    { id: "ccodezh", hintKey: "providerPreset.owned.ccodezhCodex" },
+  ),
+];
+
+export const ownedOpencodePresets: OpenCodeProviderPreset[] = [
+  register<OpenCodeProviderPreset>(
+    {
+      ...codexzh,
+      settingsConfig: {
+        npm: "@ai-sdk/openai",
