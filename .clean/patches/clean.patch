+ * modes with dedicated behavior in the upstream forms, not vendor suggestions.
+ * Keep the upstream catalogs intact for model metadata and existing user data.
+ * New vendors are excluded unless they implement an explicitly supported mode.
+ */
+export type ConnectionMode = "account" | "plugin" | "cloud";
+
+const MANAGED_ACCOUNT_TYPES = new Set([
+  "github_copilot",
+  "codex_oauth",
+  "xai_oauth",
+]);
+
+const NATIVE_ACCOUNT_NAMES = new Set([
+  "Claude Official",
+  "Claude Desktop Official",
+  "OpenAI Official",
+  "Google Official",
+  "Grok Official",
+  // CodeBuddy's official login preset has no providerKey.
+  "CodeBuddy Official",
+]);
+
+const NATIVE_ACCOUNT_KEYS = new Set([
+  "kimi-official-account",
+  "dsh-official-account",
+  "copilot-official",
+  "workbuddy-official",
+]);
+
+export function connectionModeFor(preset: AnyPreset): ConnectionMode | null {
+  const fields = preset as AnyPreset & {
+    providerType?: string;
+    providerKey?: string;
+    settingsConfig?: {
+      api?: string;
+      npm?: string;
+      env?: Record<string, unknown>;
+    };
+    templateValues?: Record<string, unknown>;
+  };
+
+  if (
+    MANAGED_ACCOUNT_TYPES.has(fields.providerType ?? "") ||
+    (preset.category === "official" &&
+      (NATIVE_ACCOUNT_NAMES.has(preset.name) ||
+        NATIVE_ACCOUNT_KEYS.has(fields.providerKey ?? "")))
+  ) {
+    return "account";
+  }
+
+  if (preset.category === "omo" || preset.category === "omo-slim") {
+    return "plugin";
+  }
+
+  const config = fields.settingsConfig;
+  const template = fields.templateValues;
+  if (
+    config?.env?.CLAUDE_CODE_USE_BEDROCK === "1" ||
+    config?.npm === "@ai-sdk/amazon-bedrock" ||
+    config?.api === "bedrock-converse-stream" ||
+    (preset.category === "cloud_provider" &&
+      (Boolean(template?.AZURE_RESOURCE_NAME) ||
+        (Boolean(template?.ACCOUNT_ID) && Boolean(template?.GATEWAY_ID))))
+  ) {
+    return "cloud";
+  }
+
+  return null;
+}
