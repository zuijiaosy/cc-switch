[Unit]
Description=Verify and publish signed CC Switch download batches
After=local-fs.target

[Service]
Type=oneshot
User=cc-switch-publish
Group=cc-switch-publish
SupplementaryGroups=cc-switch-staging
ExecStart=/usr/bin/python3 /opt/cc-switch-clean/server/publisher.py --config /etc/cc-switch-downloads/config.json --once
UMask=0027
TimeoutStartSec=20min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# Keep work -> public on one writable mount so atomic rename cannot hit EXDEV.
# Root-owned ancestors and the documented POSIX permissions restrict each user.
ReadWritePaths=/srv/client-downloads

